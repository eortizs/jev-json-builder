# Required for live requests. Mock client is used when unset.
TYPESAFE_API_KEY=

# Optional: server port for demo/server.ts and service/server.ts.
PORT=3000

# Optional: OpenRouter key for demo/image-probe.ts (image generation probe)
# and service/server.ts (image sidecar for People EVE). The same account is
# fine for development; create a dedicated workspace key per service for
# production. Never commit this file (.env is gitignored).
OPENROUTER_API_KEY=

# Optional: OpenRouter model used by service/server.ts.
# JJB_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
